# Doctor Tracker backend - copy to `.env` (git-ignored) and fill in.
# Placeholders only: never commit real credentials.

# development | test | production
NODE_ENV=development
PORT=5000

# MongoDB runs in Docker (see docker-compose.yml). URL-encode special characters
# in the username/password. The root user lives in the `admin` database.
# Backend running on the host (default local setup):
MONGODB_URI=mongodb://<user>:<password>@127.0.0.1:27017/doctor_tracker?authSource=admin
# Backend running as a container on the compose network instead:
# MONGODB_URI=mongodb://<user>:<password>@mongodb:27017/doctor_tracker?authSource=admin

# Used only by `npm test`. The database name MUST end in `_test`; tests wipe it.
MONGODB_URI_TEST=mongodb://<user>:<password>@127.0.0.1:27017/doctor_tracker_test?authSource=admin
# MONGODB_URI_TEST=mongodb://<user>:<password>@mongodb:27017/doctor_tracker_test?authSource=admin

# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Session lifetime: <number><s|m|h|d>, e.g. 15m, 12h, 1d. The cookie Max-Age matches it.
JWT_EXPIRES_IN=1d

# Exact origin(s) allowed by CORS and the CSRF origin check (comma-separated, no trailing slash).
FRONTEND_URL=http://localhost:3000
# Optional cookie Domain attribute. Leave empty unless frontend and API share a parent domain.
COOKIE_DOMAIN=

# Admin account created/updated by `npm run seed:admin` (there is no registration endpoint).
ADMIN_NAME=
ADMIN_EMAIL=
# 8-128 characters.
ADMIN_PASSWORD=

# Docker Compose (docker-compose.yml) - local MongoDB container.
# These values are applied only the first time the data volume is initialised.
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=
MONGO_INITDB_DATABASE=doctor_tracker
MONGO_PORT=27017
