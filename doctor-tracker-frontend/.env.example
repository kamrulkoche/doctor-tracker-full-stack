# Base URL of the Doctor Tracker REST API (Express backend), including the /api prefix.
# Local development against the backend on port 5000:
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Optional same-origin mode (first-party cookies, for browsers that block third-party cookies):
# set API_PROXY_TARGET to the backend ORIGIN (no /api suffix) and point NEXT_PUBLIC_API_URL at /api.
# next.config.ts then adds a pure rewrite  /api/:path*  ->  ${API_PROXY_TARGET}/api/:path*
# API_PROXY_TARGET=http://localhost:5000
# NEXT_PUBLIC_API_URL=/api

# Only used by the Playwright suite and the screenshot script (defaults shown).
# E2E_BASE_URL=http://localhost:3000
# E2E_ADMIN_EMAIL=admin@doctortracker.dev
# E2E_ADMIN_PASSWORD=Admin@12345
